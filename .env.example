# Reference only: Spring does not load this file automatically.
# Set these environment variables in the shell/IDE/deployment platform.
# Local development uses application-local.yml and compose.yml without secrets.
SPRING_PROFILES_ACTIVE=prod
LCG_ENVIRONMENT=production
DATABASE_URL=jdbc:postgresql://YOUR_DATABASE_HOST:5432/lcg
DATABASE_USERNAME=YOUR_DATABASE_USERNAME
DATABASE_PASSWORD=REPLACE_WITH_A_SECRET
REDIS_HOST=YOUR_REDIS_HOST
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_A_SECRET
# Empty means same-origin only. Separate explicit origins with commas.
CORS_ALLOWED_ORIGINS=

# Enable after registering this environment's client and exact callback.
DATAGSM_ENABLED=false
DATAGSM_CLIENT_ID=YOUR_DATAGSM_CLIENT_ID
# SDK construction requires this; PKCE token requests do not send client_secret.
DATAGSM_CLIENT_SECRET=REPLACE_WITH_A_SECRET
DATAGSM_CALLBACK_URI=https://api.lcg.example.com/api/v1/auth/school/callback
# Fixed destination; user-provided returnUrl is not used.
LOGIN_SUCCESS_URI=https://lcg.example.com
